# backend-py has one database driver, Postgres/PostGIS - no SQLite fallback
# (unlike backend/'s TypeORM setup): the whole reason this backend exists is
# real spatial analysis (GeoPandas/Shapely/GDAL), which needs real PostGIS.
# Matches docker-compose.yml's `postgis` service by default.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bhoomisetu
DB_SSL=false

# Server
PORT=8000

# Leave blank for local dev (any origin allowed). Once actually deployed
# publicly, set this to the real frontend URL (comma-separated if more than
# one).
CORS_ORIGIN=

# Canonical citizen-facing site URL - used to build real deep links (e.g.
# the official document PDF's QR code links straight to that parcel's page).
# Defaults to the Vite dev server's own default port if unset.
FRONTEND_URL=http://localhost:5173

# Set to "production" only for a real deployment - the app then refuses to
# start unless a real JWT_SECRET (not the placeholder below) and real DB
# credentials are also set, same checks as backend/'s main.ts.
ENVIRONMENT=

# Same payload shape/verification logic as backend/src/auth/jwt.strategy.ts
# (sub, email, role, tokenVersion) - see PYTHON_MIGRATION_PLAN.md §2. Must
# match backend/'s JWT_SECRET during the side-by-side period so a token
# minted by one is never mistakenly accepted by the other via a shared
# default.
JWT_SECRET=change_this_in_production

# Same as backend/.env.example - see that file's comments for details on
# each of these. Left blank here; copy real values from backend/.env once
# this module needs them (AiModule, NotificationsModule, HistoricalImageryModule).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_SIM_SUBSCRIPTION_ID=2
MAIL_HOST=smtp.zoho.in
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=BhoomiSetu <no-reply@bhoomisetu.gov.in>
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Historical-imagery comparison's narrative step (an OpenRouter-hosted LLM,
# same as backend/'s narrative.service.ts - independent of GROQ_API_KEY
# above). Leave blank to run without it - the comparison endpoint still
# works, falling back to the real underlying facts, plainly phrased.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Google Earth Engine - real Sentinel-2 imagery for Change Detection's
# satellite-sourced analysis path (POST /change-detection/analyze-satellite).
# Service-account auth: GEE_SERVICE_ACCOUNT_EMAIL is the service account's
# client_email (its Cloud project must have the Earth Engine API enabled and
# have granted this account the "Earth Engine Resource Viewer" role);
# GEE_SERVICE_ACCOUNT_KEY_PATH is the path to its downloaded JSON key file
# (relative to backend-py/, or absolute) - the key file itself is never
# committed (see .gitignore). Leave both blank to run without it - the
# manual-upload /change-detection/analyze endpoint is unaffected either way.
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Bhashini multilingual API (Government of India) - get credentials at
# https://bhashini.gov.in/. Leave blank to run without it - static UI text
# falls back to English, and /multilingual/* live-translation endpoints 503.
ULCA_USER_ID=
ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=hi

# Google OAuth 2.0 - for "Sign in with Google" button on login/register pages.
# Get credentials from Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI must be set to: <FRONTEND_URL>/auth/callback
# (e.g. http://localhost:5173/auth/callback for local dev)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
