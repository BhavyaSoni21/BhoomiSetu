# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
coverage/

# Vite's local dependency pre-bundling cache - regenerates automatically,
# not something to commit.
frontend/.vite/

# Env files
.env
.env.*
*.env
.env.local
# backend/.env.example survives this via a historical force-add; this
# negation does the same for backend-py's without needing another one.
!backend-py/.env.example

# Logs
*.log

# Data
backend/data/*.sqlite
backend/data/*.sqlite-journal

# Google Cloud / Earth Engine service-account key files - real credentials,
# never committed regardless of where under the repo they're saved. Covers
# both a manually-chosen name and Cloud Console's own default download name
# (<project-id>-<key-id>.json, e.g. bhoomisetu-508519-98e51431e29a.json).
*service-account*.json
*serviceaccount*.json
client_secret_*.json
backend-py/bhoomisetu-*.json

# backend-py (Python)
*.py[cod]
*$py.class
backend-py/__pycache__/
backend-py/**/__pycache__/
backend-py/.venv/
backend-py/venv/
backend-py/.pytest_cache/
backend-py/uploads/
backend-py/*.db
backend-py/*.sqlite
backend-py/*.sqlite-*

# OSM road-bearing lookups cached by scripts/seed.py's cluster generator -
# regenerates automatically (queries Overpass on cache miss), not something
# to commit.
backend-py/scripts/.osm_road_bearing_cache.json

# Python tooling caches and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# tesseract.js downloads and caches its language model into the working
# directory on first OCR call (docs/FEATURE_AUDIT.md's Document Verification
# feature) - a ~5MB binary that regenerates automatically, not something to
# commit.
backend/*.traineddata

# Historical parcel-imagery snapshot archive (docs/FRONTEND_UPGRADE_SPEC.md
# §8) - seed.ts-generated PNGs, regenerated by every `npm run seed`, not
# something to commit.
backend/uploads/

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test artifacts
test*.pdf
backend-py/_img.png

# Graphify cache
graphify-out/cache/

#maps pbf
map/

# Temporary check/debug scripts
backend-py/check_*.py
backend-py/delete_osm_pbf.py

# Temporary auth page files in root
auth_login_page.tsx
auth_register_page.tsx

# Stray local SQLite DBs — backend is Postgres/Supabase-only
*.db
*.sqlite
*.sqlite3
