# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Vite's local dependency pre-bundling cache - regenerates automatically,
# not something to commit.
frontend/.vite/

# Env files
.env
.env.*
*.env
.env.local
# backend/.env.example survives this via a historical force-add; this
# negation does the same for backend-py's without needing another one.
!backend-py/.env.example

# Logs
*.log

# Data
backend/data/*.sqlite
backend/data/*.sqlite-journal

# backend-py (Python)
backend-py/__pycache__/
backend-py/**/__pycache__/
backend-py/.venv/
backend-py/venv/
backend-py/.pytest_cache/
backend-py/uploads/

# tesseract.js downloads and caches its language model into the working
# directory on first OCR call (docs/FEATURE_AUDIT.md's Document Verification
# feature) - a ~5MB binary that regenerates automatically, not something to
# commit.
backend/*.traineddata

# Historical parcel-imagery snapshot archive (docs/FRONTEND_UPGRADE_SPEC.md
# §8) - seed.ts-generated PNGs, regenerated by every `npm run seed`, not
# something to commit.
backend/uploads/

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

