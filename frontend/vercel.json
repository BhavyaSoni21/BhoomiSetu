{
    "rewrites":  [
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        },
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=31536000; includeSubDomains"
                                        },
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "geolocation=(self), microphone=(self), camera=()"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; base-uri \u0027self\u0027; frame-ancestors \u0027none\u0027; object-src \u0027none\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027 \u0027unsafe-eval\u0027 blob:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 https://fonts.googleapis.com; font-src \u0027self\u0027 https://fonts.gstatic.com data:; img-src \u0027self\u0027 data: blob: https:; connect-src \u0027self\u0027 https: wss:; worker-src \u0027self\u0027 blob:; frame-src \u0027self\u0027 https://accounts.google.com;"
                                        }
                                    ]
                    }
                ]
}