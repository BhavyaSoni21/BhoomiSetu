# Set to "true" to use the SQLite dev database (default when DB_HOST is unset).
# Set to "false" (and configure DB_* below) to use PostgreSQL/PostGIS.
USE_SQLITE=true
SQLITE_PATH=./data/dev.sqlite

# PostgreSQL/PostGIS connection (used when USE_SQLITE=false). Example below
# is a local/docker-compose Postgres with no SSL listener.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bhoomisetu
DB_SSL=false

# Managed Postgres (e.g. Supabase) instead of a local instance: set DB_SSL=true
# (most managed providers require it) and, for Supabase specifically, use its
# connection *pooler* host/username rather than the direct-connection one -
# the direct host (db.<project-ref>.supabase.co) is IPv6-only and won't
# resolve from an IPv4-only environment (docs/FEATURE_AUDIT.md §8 item 14):
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_PORT=6543
#   DB_USERNAME=postgres.<project-ref>
#   DB_SSL=true

# Server
PORT=3000

# Leave blank for local dev (any origin allowed, matching what
# npm run start:dev has always done). Once actually deployed publicly, set
# this to your real frontend URL (comma-separated if more than one) so only
# that origin's browser requests are allowed - e.g.
# CORS_ORIGIN=https://bhoomisetu.example.com
CORS_ORIGIN=

# Set to "production" only for a real deployment (docker-compose.yml already
# does this for you) - the app then refuses to start unless a real
# JWT_SECRET (not the placeholder value below) is also set, rather than
# silently running with a publicly-known secret. Leave unset for local dev.
NODE_ENV=

# Signs officer/admin login tokens (POST /api/v1/auth/login, GET /auth/me -
# see docs/FEATURE_AUDIT.md §8 item 9). Change this for any real deployment;
# the default here matches docker-compose.yml's own fallback.
JWT_SECRET=change_this_in_production

# Phase 8 AI endpoints (POST /api/v1/ai/query, /ai/parcels/:id/explain,
# /ai/alerts/:id/explain). Get a free key at https://console.groq.com/keys.
# Leave blank to run without AI - those 3 endpoints return 503 instead of
# calling Groq, everything else in the app is unaffected. Groq's available
# models change over time; if GROQ_MODEL 404s, list current ones with
# `curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"`.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Citizen registration/Profile mobile OTP (docs/FRONTEND_UPGRADE_SPEC.md §3).
# No SMS provider is currently chosen - Fast2SMS was evaluated (SmsService is
# still shaped around its /otp/send + /otp/verify API) but is NOT the
# provider going forward, so leave these blank. Mobile-verification calls
# return 503 instead of sending a real code; registration/Profile/email OTP
# all still work fully, unaffected. If a different SMS provider is chosen
# later, SmsService (backend/src/notifications/sms.service.ts) needs to be
# rewritten against that provider's API - these two vars are Fast2SMS-shaped
# and won't apply as-is to a different vendor.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=

# Citizen registration/Profile email OTP (docs/FRONTEND_UPGRADE_SPEC.md §3).
# Plain SMTP via nodemailer - works with any SMTP-capable provider (Gmail app
# password, Outlook, a transactional service's SMTP relay, ...), not a
# specific vendor's API. Leave SMTP_HOST blank to run without email OTP -
# same 503-instead-of-GROQ_API_KEY-missing pattern as above.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BhoomiSetu <no-reply@bhoomisetu.gov.in>

# Image storage (historical-imagery snapshots, seeded parcel documents,
# citizen-submitted workflow evidence). Leave both blank for local dev/tests -
# images fall back to backend/uploads/ on local disk, zero setup needed, same
# as before. Set both once you actually deploy somewhere with an ephemeral or
# per-instance filesystem (most hosted platforms) - backend/uploads/ won't
# survive a redeploy/restart there, so images go to Supabase Storage instead.
# Find these under your Supabase project's Settings -> API: SUPABASE_URL is
# the "Project URL" (https://<project-ref>.supabase.co); SUPABASE_SECRET_KEY
# is the "Secret keys" entry (current-gen key format, starts sb_secret_...;
# older projects instead show a "service_role" JWT under "Legacy API keys" -
# either works here). NOT the "Publishable key"/"anon" key - the secret key
# bypasses Row Level Security, is used server-side only, and must never be
# sent to the frontend or committed anywhere. The storage bucket itself
# ('bhoomisetu-uploads') is created automatically on first use if it doesn't
# already exist.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
