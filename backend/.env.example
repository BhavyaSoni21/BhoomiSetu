# Set to "true" to use the SQLite dev database (default when DB_HOST is unset).
# Set to "false" (and configure DB_* below) to use PostgreSQL/PostGIS.
USE_SQLITE=true
SQLITE_PATH=./data/dev.sqlite

# PostgreSQL/PostGIS connection (used when USE_SQLITE=false)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bhoomisetu

# Server
PORT=3000

# Reserved for future phases (not yet read by the app)
JWT_SECRET=change_this_in_production
GROQ_API_KEY=
