{
  "name": "backend",
  "version": "1.0.0",
  "description": "BhoomiSetu Backend - GIS-based land governance platform",
  "main": "src/main.ts",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only functions",
    "test": "jest",
    "test:e2e-live": "jest --runInBand --testRegex \"test/live/.*\\.live-spec\\.ts$\"",
    "lint": "eslint .",
    "seed": "ts-node -P tsconfig.json seed.ts",
    "seed:demo-activity": "ts-node -P tsconfig.json seed-demo-activity.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.e2e-spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "keywords": [
    "nestjs",
    "typescript",
    "gis",
    "land-governance"
  ],
  "author": "BhoomiSetu Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.1",
    "openai": "^7.10.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.4",
    "sqlite3": "^6.0.1",
    "tesseract.js": "^7.0.0",
    "typeorm": "^0.3.0",
    "zod": "^3.20.0"
  },
  "overrides": {
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^3.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^2.0.0",
    "eslint": "^10.10.0",
    "jest": "^29.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  }
}
